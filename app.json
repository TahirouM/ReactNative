{
  "expo": {
    "name": "ClubSport",
    "slug": "clubsport-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clubsport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.clubsport.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ClubSport utilise votre position pour afficher les salles et les séances les plus proches, et pour confirmer que vous êtes bien sur place lors du pointage de présence.",
        "NSCameraUsageDescription": "ClubSport utilise l'appareil photo pour lire le QR code affiché à l'entrée de la salle et valider votre présence à une séance réservée."
      }
    },
    "android": {
      "package": "fr.clubsport.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f4f6fa",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f4f6fa"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ClubSport utilise votre position pour trier les séances par distance et vérifier votre présence sur place."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ClubSport utilise l'appareil photo pour lire le QR code de la borne et valider votre présence.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}
